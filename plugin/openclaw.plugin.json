      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiBase", "lineUid", "threadTrust"],
        "properties": {
          "apiBase": { "type": "string" },
          "lineUid": { "type": "string" },
          "emailLineUid": { "type": "string" },
          "groups": { "type": "object" },
          "emailName": { "type": "string" },
          "threadTrust": { "type": "string", "enum": ["ask", "trusted", "untrusted"] }
        }
      }
    }
  }
}
